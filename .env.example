# Apogee environment. Copy this file to .env and fill in the blanks:
#
#   cp .env.example .env        (PowerShell: copy .env.example .env)
#
# .env is in .gitignore; this template is committed and must never hold a real key.
# See SETUP.md for where each value comes from.
#
# Paste values directly after the "=", with no quotes and no spaces.

# ---------------------------------------------------------------------------
# From: Supabase dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------

# "Project URL" - the bare origin only, with no path on the end.
# The client libraries append their own paths (/rest/v1, /auth/v1, /functions/v1),
# so including one here makes every request resolve to the wrong place.
APOGEE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# "anon" / "publishable" key. SAFE to ship in the desktop app: row-level security is
# what protects the data, not this key.
APOGEE_SUPABASE_ANON_KEY=sb_publishable_...

# "service_role" / "secret" key. BYPASSES row-level security completely.
# Server-side only. Never ship it, never commit it, never paste it in a chat.
#
# It is needed here because two local tools authenticate as the server:
# `npm run sync:reference` writes reference data, and `npm run verify:deployment`
# reads rows an anon caller must not see. Neither the desktop client nor anything
# in dist/app ever reads this variable - `npm run doctor` reports only whether it
# is set, never its value.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ---------------------------------------------------------------------------
# Derived: your project URL with /functions/v1/steam-auth appended.
#
# Edge Functions live under /functions/v1/. The /rest/v1/ path is PostgREST, which
# serves the database tables and knows nothing about functions - pointing these there
# breaks Steam sign-in entirely.
#
# Two variables because the desktop client and the Edge Function each read one.
# ---------------------------------------------------------------------------

APOGEE_STEAM_AUTH_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/steam-auth
STEAM_AUTH_FUNCTION_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/steam-auth

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# https://steamcommunity.com/dev/apikey
# Without this, sign-in still works but players get a generic name and no avatar.
STEAM_WEB_API_KEY=
