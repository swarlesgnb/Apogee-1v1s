  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/node": "^22.10.2",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "supabase": "^2.114.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "main": "dist/app/main.cjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3"
  }
