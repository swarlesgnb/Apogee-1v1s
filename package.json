    "validate:kovaaks": "tsx src/core/verify/validateKovaaks.ts",
    "validate:glicko": "tsx src/core/rating/validateGlicko.ts",
    "validate:match": "tsx src/core/match/validateMatch.ts",
    "validate:playlist": "tsx src/core/match/validatePlaylist.ts",
    "validate:quests": "tsx src/core/quests/validateQuests.ts",
    "build:score-models": "tsx src/core/verify/buildScoreModels.ts",
    "build:durations": "tsx src/core/verify/buildDurations.ts",
    "build:subskills": "tsx tools/deriveSubskills.ts",
    "validate:duration": "tsx src/core/stats/validateDuration.ts",
    "validate:season": "tsx src/core/season/validateSeasonEdits.ts",
    "validate:pool": "tsx src/core/season/validatePool.ts",
    "validate:thresholds": "tsx src/core/season/validateThresholds.ts",
    "validate:rationale": "tsx src/core/season/validateRationale.ts",
    "validate:aimtypes": "tsx src/core/season/validateAimTypes.ts",
    "validate:standing": "tsx src/core/season/validateStanding.ts",
    "compare:baselines": "tsx src/core/history/compareBaselines.ts",
    "measure:coldstart": "tsx src/core/history/coldStart.ts",
    "snapshot": "tsx src/core/report/exportSnapshot.ts",
    "ui": "tsx src/core/report/exportSnapshot.ts && tsx tools/buildUiPreview.ts",
    "validate": "npm run validate:parser && npm run validate:duration && npm run validate:season && npm run validate:pool && npm run validate:thresholds && npm run validate:rationale && npm run validate:aimtypes && npm run validate:standing && npm run validate:engine && npm run validate:ranks && npm run validate:sync && npm run validate:verify && npm run validate:kovaaks && npm run validate:glicko && npm run validate:match && npm run validate:playlist && npm run validate:quests && npm run validate:live && npm run validate:schema && npm run validate:functions && npm run validate:sound && npm run validate:progression",
    "ranks": "tsx src/core/ranks/validateRanks.ts",
    "typecheck": "tsc --noEmit",
    "build:app": "node tools/buildApp.mjs",
    "start": "npm run build:app && electron .",
    "dev": "node tools/devApp.mjs",
    "doctor": "tsx tools/doctor.ts",
    "build:icon": "node tools/buildIcon.mjs",
    "dist": "npm run build:icon && npm run build:app && electron-builder --win",
    "smoke": "npm run build:app && electron . --smoke",
    "validate:live": "tsx src/core/match/validateLiveQueue.ts",
    "beta": "tsx tools/betaReadiness.ts",
    "validate:schema": "tsx tools/validateSchema.ts",
    "validate:functions": "tsx tools/validateFunctionImports.ts",
    "validate:sound": "node tools/validateSound.mjs",
    "verify:deployment": "tsx tools/verifyDeployment.ts",
    "grant:admin": "tsx tools/grantAdmin.ts",
    "build:season": "tsx tools/buildSeason.ts",
    "docs:ranks": "tsx tools/buildRankSheet.ts",
    "push:season": "tsx tools/pushSeason.ts",
    "fetch:evxl": "tsx tools/fetchEvxlRegistry.ts",
    "sync:reference": "tsx tools/syncReferenceData.ts",
    "deploy:functions": "npx supabase functions deploy steam-auth && npx supabase functions deploy submit-run && npx supabase functions deploy find-match && npx supabase functions deploy settle-match && npx supabase functions deploy abandon-match && npx supabase functions deploy refresh-baselines && npx supabase functions deploy refresh-apex && npx supabase functions deploy apex-board",
    "validate:progression": "tsx src/core/quests/validateProgression.ts",
    "validate:consistency": "tsx src/core/consistency/report.ts --compare",
    "consistency": "tsx src/core/consistency/report.ts",
    "sample:leaderboards": "tsx tools/sampleLeaderboards.ts",
    "sample:apex": "tsx tools/sampleApex.ts",
    "calibrate": "tsx tools/calibrateLadder.ts",
    "cross": "tsx tools/crossBenchmark.ts",
    "distribution": "tsx src/core/season/validateDistribution.ts",
    "coverage": "tsx src/core/history/validateCoverage.ts",
    "practice": "tsx tools/checkPractice.ts"
